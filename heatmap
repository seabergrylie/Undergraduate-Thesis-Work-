import pandas as pd
import matplotlib.pyplot as plt

# -------------------------------
# Load pairwise Fst matrix
# -------------------------------
# Replace with your file name
# Assumes first column contains row labels and the first row contains column labels
fst_df = pd.read_csv("fst_matrix.csv", index_col=0)

# -------------------------------
# Plot heatmap
# -------------------------------
fig, ax = plt.subplots(figsize=(8, 6))

cax = ax.imshow(fst_df.values, interpolation="nearest", aspect="auto")
cbar = fig.colorbar(cax)
cbar.set_label("Pairwise Fst")

# Set axis ticks and labels
ax.set_xticks(range(len(fst_df.columns)))
ax.set_yticks(range(len(fst_df.index)))
ax.set_xticklabels(fst_df.columns, rotation=45, ha="right")
ax.set_yticklabels(fst_df.index)

# Add values inside cells
for i in range(len(fst_df.index)):
    for j in range(len(fst_df.columns)):
        ax.text(j, i, f"{fst_df.iloc[i, j]:.3f}",
                ha="center", va="center", fontsize=8)

ax.set_title("Pairwise Fst Heatmap")
plt.tight_layout()
plt.show()
