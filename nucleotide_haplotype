from Bio import AlignIO
file_path = 'filepath'

def read_fasta(file_path):
    alignment = AlignIO.read(file_path, "fasta")
    return alignment

from collections import Counter
import numpy as np

# Function to calculate haplotype diversity
def haplotype_diversity(alignment):
    haplotypes = [''.join(record.seq) for record in alignment]
    haplotype_counts = Counter(haplotypes)
    n = sum(haplotype_counts.values())
    hd = n * (1 - sum((count / n) ** 2 for count in haplotype_counts.values())) / (n - 1)
    return hd

# Function to calculate nucleotide diversity
def nucleotide_diversity(alignment):
    sequences = [record.seq for record in alignment]
    n = len(sequences)
    sites = len(sequences[0])
    pi_total = 0

    for i in range(sites):
        site_variants = [seq[i] for seq in sequences]
        freqs = np.array(list(Counter(site_variants).values())) / n
        pi_site = sum([2 * freq_i * freq_j for i, freq_i in enumerate(freqs) for j, freq_j in enumerate(freqs) if i != j])
        pi_total += pi_site

    pi_mean = pi_total / sites
    return pi_mean

# Main function
def main(file_path):
    alignment = read_fasta(file_path)
    hd = haplotype_diversity(alignment)
    pi = nucleotide_diversity(alignment)
    print(f"Haplotype Diversity: {hd}")
    print(f"Nucleotide Diversity: {pi}")

# File path
file_path = "filepath"
main(file_path)
